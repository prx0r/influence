{
  "id": "product-post",
  "version": "v1",
  "description": "Product social posts (X/IG/Pinterest). Typed Jev judgments, 5 reps.",
  "stateFields": ["hook_text", "script_body", "caption"],
  "outcomes": {
    "reach_rate": "views / followers_at_post",
    "conversion_rate": "(saves + shares + clicks) / views"
  },
  "questions": [
    {"id": "hook_question", "type": "bool", "tier": "primary",
     "question": "The hook is phrased as a direct question to the viewer.",
     "note": "Refers to {hook_text}."},
    {"id": "product_visible", "type": "score", "tier": "primary", "levels": 5,
     "question": "How clearly is the product and what it does communicated?",
     "criteria": ["unclear", "vague", "understandable", "clear", "instantly obvious"]},
    {"id": "proof_concrete", "type": "bool", "tier": "primary",
     "question": "The post contains concrete proof (price, size, material, review, number).",
     "note": "Refers to {script_body}."},
    {"id": "gift_angle", "type": "bool", "tier": "primary",
     "question": "The post frames the product as a gift for someone (not just self-purchase).",
     "note": "Refers to {script_body}."},
    {"id": "urgency", "type": "score", "tier": "exploratory", "levels": 5,
     "question": "How much urgency or scarcity does the post convey?",
     "criteria": ["none", "mild", "moderate", "strong", "hard sell"]},
    {"id": "payoff_warmth", "type": "score", "tier": "primary", "levels": 5,
     "question": "How warm is the emotional payoff?",
     "criteria": ["cold", "neutral", "mildly warm", "heartwarming", "tearjerker"]},
    {"id": "cta_explicit", "type": "bool", "tier": "primary",
     "question": "There is an explicit call to action (shop link, comment, save).",
     "note": "Refers to {script_body} and {caption}."},
    {"id": "brand_fit", "type": "score", "tier": "primary", "levels": 5,
     "question": "How well does this fit an odd-gifts brand voice (warm, specific, anti-generic)?",
     "criteria": ["off-brand", "neutral", "compatible", "on-brand", "signature"]},
    {"id": "specificity", "type": "score", "tier": "exploratory", "levels": 5,
     "question": "How specific vs generic is the language overall?",
     "criteria": ["generic", "somewhat generic", "mixed", "specific", "hyper-specific"]},
    {"id": "negativity", "type": "score", "tier": "exploratory", "levels": 5,
     "question": "How negative, snarky, or mocking is the tone?",
     "criteria": ["warm", "neutral", "mild edge", "snarky", "mean"]}
  ],
  "directions": {
    "hook_question": "higher",
    "product_visible": "higher",
    "proof_concrete": "higher",
    "gift_angle": "higher",
    "urgency": "neutral",
    "payoff_warmth": "higher",
    "cta_explicit": "higher",
    "brand_fit": "higher",
    "specificity": "higher",
    "negativity": "lower"
  }
}
