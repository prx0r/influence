{
  "id": "video-script",
  "version": "v1",
  "description": "Short-form video scripts (TikTok/Reels/Shorts). Typed Jev judgments, 5 reps.",
  "stateFields": ["hook_text", "script_body", "caption"],
  "outcomes": {
    "reach_rate": "views / followers_at_post",
    "conversion_rate": "(saves + shares + clicks) / views"
  },
  "questions": [
    {"id": "hook_question", "type": "bool", "tier": "primary",
     "question": "The hook is phrased as a direct question to the viewer.",
     "note": "Refers to {hook_text}."},
    {"id": "hook_surprise", "type": "score", "tier": "primary", "levels": 5,
     "question": "How surprising is the opening?",
     "criteria": ["expected opening", "mild twist", "genuine surprise", "shocking", "unbelievable"]},
    {"id": "hook_specific", "type": "bool", "tier": "primary",
     "question": "The hook names a specific person, pet, number, or place (not generic).",
     "note": "Refers to {hook_text}."},
    {"id": "proof_in_hook", "type": "bool", "tier": "primary",
     "question": "The hook contains or promises concrete proof (a result, a before/after, a number).",
     "note": "Refers to {hook_text}."},
    {"id": "structure_story", "type": "bool", "tier": "primary",
     "question": "The script follows a story arc (setup, tension, payoff) rather than a list or lecture.",
     "note": "Refers to {script_body}."},
    {"id": "mechanism_density", "type": "score", "tier": "primary", "levels": 5,
     "question": "How densely packed is the script with concrete mechanisms, details, or steps?",
     "criteria": ["vague", "one detail", "several details", "dense", "every line concrete"]},
    {"id": "payoff_warmth", "type": "score", "tier": "primary", "levels": 5,
     "question": "How warm is the emotional payoff?",
     "criteria": ["cold", "neutral", "mildly warm", "heartwarming", "tearjerker"]},
    {"id": "payoff_curiosity", "type": "score", "tier": "exploratory", "levels": 5,
     "question": "How much curiosity does the ending leave unresolved?",
     "criteria": ["fully closed", "mostly closed", "some open loops", "strong cliffhanger", "maddening"]},
    {"id": "cta_explicit", "type": "bool", "tier": "primary",
     "question": "There is an explicit call to action (follow, comment, click, buy).",
     "note": "Refers to {script_body} and {caption}."},
    {"id": "brand_fit", "type": "score", "tier": "primary", "levels": 5,
     "question": "How well does this fit an odd-gifts brand voice (warm, specific, anti-generic)?",
     "criteria": ["off-brand", "neutral", "compatible", "on-brand", "signature"]},
    {"id": "negativity", "type": "score", "tier": "exploratory", "levels": 5,
     "question": "How negative, snarky, or mocking is the tone?",
     "criteria": ["warm", "neutral", "mild edge", "snarky", "mean"]},
    {"id": "specificity", "type": "score", "tier": "exploratory", "levels": 5,
     "question": "How specific vs generic is the language overall?",
     "criteria": ["generic", "somewhat generic", "mixed", "specific", "hyper-specific"]}
  ],
  "directions": {
    "hook_question": "higher",
    "hook_surprise": "higher",
    "hook_specific": "higher",
    "proof_in_hook": "higher",
    "structure_story": "higher",
    "mechanism_density": "higher",
    "payoff_warmth": "higher",
    "payoff_curiosity": "neutral",
    "cta_explicit": "higher",
    "brand_fit": "higher",
    "negativity": "lower",
    "specificity": "higher"
  }
}
